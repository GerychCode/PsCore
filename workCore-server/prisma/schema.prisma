generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  telegramId   String?        @unique
  avatar       String      @default("")
  firstName    String
  lastName     String
  email        String      @unique
  phone        String?
  address      String?
  passwordHash String
  role         Role        @default(Employe)
  baseLevel    Int         @default(1) @map("base_level")
  // Дефолт true, щоб наявні користувачі не залишились незапідтвердженими;
  // реєстрація явно ставить false і вимагає підтвердження пошти
  isEmailVerified Boolean  @default(true) @map("is_email_verified")
  dateOfBirth  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workShift    WorkShift[]
  workSchedule WorkSchedule[]
  notifications Notification[]
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  departments      Department[]  @relation("DepartmentMembers")
  scheduleWishes   ScheduleWish[]
  appRoles         AppRole[]     @relation("UserRoles")
}

model AppRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color       String   @default("#99AAB5")
  permissions String[] @default([])
  position    Int      @default(0)
  isSystem    Boolean  @default(false) @map("is_system")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  members     User[]   @relation("UserRoles")

  @@map("app_roles")
}

enum Role {
  Employe
  Admin
}

model Department {
  id                  Int      @id @default(autoincrement())
  name                String
  telegramId          Int?     @unique
  weekdaysOpeningTime String   @map("weekdays_opening_time")
  weekdaysClosingTime String   @map("weekdays_closing_time")
  weekendsOpeningTime String   @map("weekends_opening_time")
  weekendsClosingTime String   @map("weekends_closing_time")
  address             String?
  latitude            Float?
  longitude           Float?
  isActive            Boolean? @default(true) @map("is_active")
  staffingByWeekday   Json?    @map("staffing_by_weekday")

  shiftDepartments    WorkShift[]
  scheduleDepartments WorkSchedule[]
  scheduleLocks       WorkScheduleLock[]
  members             User[]   @relation("DepartmentMembers")

  @@map("departments")
}

model WorkShift {
  id           Int         @id @default(autoincrement())
  userId       Int         @map("user_id")
  departmentId Int         @map("department_id")
  date         DateTime    @map("date")
  startedAt    String      @map("started_at")
  endTime      String      @map("end_time")
  totalHours   Float       @map("total_hours")
  status       ShiftStatus @default(PENDING)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  tags     Tag[]      @relation("ShiftTags")

  @@map("work_shifts")
}

model Tag {
  id          Int    @id @default(autoincrement())
  name        String @unique
  severity    Int    @default(1)
  description String?
  shifts      WorkShift[] @relation("ShiftTags")

  @@map("tags")
}

enum ShiftStatus {
  PENDING
  APPROVED
  REJECTED
}

model WorkSchedule {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  departmentId Int      @map("department_id")
  date         DateTime @map("date")
  startedAt    String   @map("started_at")
  endTime      String   @map("end_time")
  isDayOff     Boolean? @default(false) @map("is_day_off")
  isDraft      Boolean  @default(false) @map("is_draft")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@map("work_schedule")
}

model ScheduleWish {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  date      DateTime @map("date")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("schedule_wishes")
}

model WorkScheduleLock {
  id           Int      @id @default(autoincrement())
  departmentId Int      @map("department_id")
  weekStart    DateTime @map("week_start")
  isLocked     Boolean  @default(false) @map("is_locked")

  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, weekStart])
  @@map("work_schedule_locks")
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int      @map("sender_id")
  receiverId Int      @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, id])
  @@index([receiverId, isRead])
  @@map("chat_messages")
}