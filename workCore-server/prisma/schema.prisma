generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  telegramId   String?        @unique
  avatar       String      @default("")
  firstName    String
  lastName     String
  email        String      @unique
  phone        String?
  address      String?
  passwordHash String
  role         Role        @default(Employe)
  baseLevel    Int         @default(1) @map("base_level")
  // Дефолт true, щоб наявні користувачі не залишились незапідтвердженими;
  // реєстрація явно ставить false і вимагає підтвердження пошти
  isEmailVerified Boolean  @default(true) @map("is_email_verified")
  // Примусова зміна пароля при першому вході (сіданий суперадмін)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  // Налаштування сповіщень: { категорія: { web: bool, telegram: bool } }
  notificationPrefs Json?   @map("notification_prefs")
  dateOfBirth  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workShift    WorkShift[]
  workSchedule WorkSchedule[]
  notifications Notification[]
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  departments      Department[]  @relation("DepartmentMembers")
  scheduleWishes   ScheduleWish[]
  appRoles         AppRole[]     @relation("UserRoles")
  swapRequests     ShiftSwap[]   @relation("SwapRequester")
  swapClaims       ShiftSwap[]   @relation("SwapClaimer")
  swapTargets      ShiftSwap[]   @relation("SwapTarget")
  auditLogs        AuditLog[]    @relation("AuditActor")
}

model AppRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color       String   @default("#99AAB5")
  permissions String[] @default([])
  position    Int      @default(0)
  isSystem    Boolean  @default(false) @map("is_system")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  members     User[]   @relation("UserRoles")

  @@map("app_roles")
}

enum Role {
  Employe
  Admin
}

model Department {
  id                  Int      @id @default(autoincrement())
  name                String
  // Telegram chat id акаунта відділення (для кодів верифікації змін)
  telegramId          String?  @unique
  weekdaysOpeningTime String   @map("weekdays_opening_time")
  weekdaysClosingTime String   @map("weekdays_closing_time")
  weekendsOpeningTime String   @map("weekends_opening_time")
  weekendsClosingTime String   @map("weekends_closing_time")
  address             String?
  latitude            Float?
  longitude           Float?
  isActive            Boolean? @default(true) @map("is_active")
  staffingByWeekday   Json?    @map("staffing_by_weekday")

  // Обмеження навантаження для генератора графіка. null = взяти значення
  // за замовчуванням з коду (див. DEFAULT_LOAD_LIMITS); 0 = обмеження вимкнено.
  maxHoursPerWeek     Int?     @map("max_hours_per_week")
  maxConsecutiveDays  Int?     @map("max_consecutive_days")
  minRestHours        Int?     @map("min_rest_hours")

  shiftDepartments    WorkShift[]
  scheduleDepartments WorkSchedule[]
  scheduleLocks       WorkScheduleLock[]
  members             User[]   @relation("DepartmentMembers")

  @@map("departments")
}

model WorkShift {
  id           Int         @id @default(autoincrement())
  userId       Int         @map("user_id")
  departmentId Int         @map("department_id")
  date         DateTime    @map("date")
  startedAt    String      @map("started_at")
  endTime      String      @map("end_time")
  totalHours   Float       @map("total_hours")
  status       ShiftStatus @default(PENDING)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // onDelete: Cascade — видалення користувача прибирає його зміни (право на
  // стирання/GDPR). Без цього user.delete падав на FK-обмеженні (500).
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  tags     Tag[]      @relation("ShiftTags")

  @@map("work_shifts")
}

model Tag {
  id          Int    @id @default(autoincrement())
  name        String @unique
  severity    Int    @default(1)
  description String?
  // Системні теги створює сама система (запізнення, авто-завершення тощо);
  // їх не можна видаляти/перейменовувати вручну. color — для UI-бейджа.
  isSystem    Boolean @default(false) @map("is_system")
  color       String?
  // Кастомна автоматизація тега (задає адмін). autoApply=true → тег
  // авто-навішується на зміну, якщо rule.conditions збігаються; rule.actions —
  // безпечні декларативні «події» (сповіщення). Довільний код НЕ виконується.
  autoApply   Boolean @default(false) @map("auto_apply")
  rule        Json?
  shifts      WorkShift[] @relation("ShiftTags")

  @@map("tags")
}

enum ShiftStatus {
  PENDING
  APPROVED
  REJECTED
}

model WorkSchedule {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  departmentId Int      @map("department_id")
  date         DateTime @map("date")
  startedAt    String   @map("started_at")
  endTime      String   @map("end_time")
  isDayOff     Boolean? @default(false) @map("is_day_off")
  isDraft      Boolean  @default(false) @map("is_draft")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])
  swaps      ShiftSwap[]

  // Один плановий рядок на людину на день (дата нормалізується до startOfDay).
  // Захищає від гонки «два розклади на день» на рівні БД.
  @@unique([userId, date])
  @@map("work_schedule")
}

enum SwapStatus {
  OPEN // виставлено, чекає охочого
  CLAIMED // хтось погодився забрати, чекає підтвердження менеджера
  APPROVED // передано новому працівнику
  REJECTED // менеджер відхилив
  CANCELLED // автор скасував
}

/// Обмін/передача планової зміни (WorkSchedule) між співробітниками.
model ShiftSwap {
  id           Int        @id @default(autoincrement())
  scheduleId   Int        @map("schedule_id")
  requesterId  Int        @map("requester_id")
  // Направлена пропозиція конкретній людині (null = відкрито для відділення)
  targetUserId Int?       @map("target_user_id")
  // Хто погодився забрати зміну
  claimerId    Int?       @map("claimer_id")
  status       SwapStatus @default(OPEN)
  reason       String?
  createdAt    DateTime   @default(now()) @map("created_at")
  resolvedAt   DateTime?  @map("resolved_at")

  schedule   WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  requester  User         @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target     User?        @relation("SwapTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  claimer    User?        @relation("SwapClaimer", fields: [claimerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([scheduleId])
  @@map("shift_swaps")
}

/// Журнал аудиту: хто, що і над чим зробив (ролі, зміни, користувачі, свопи).
model AuditLog {
  id        Int      @id @default(autoincrement())
  // null = системна дія (напр. авто-завершення зміни за розкладом)
  actorId   Int?     @map("actor_id")
  action    String // напр. "SHIFT_APPROVED", "ROLE_DELETED"
  entity    String // напр. "WorkShift", "AppRole"
  entityId  Int?     @map("entity_id")
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ScheduleWish {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  date      DateTime @map("date")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("schedule_wishes")
}

model WorkScheduleLock {
  id           Int      @id @default(autoincrement())
  departmentId Int      @map("department_id")
  weekStart    DateTime @map("week_start")
  isLocked     Boolean  @default(false) @map("is_locked")

  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, weekStart])
  @@map("work_schedule_locks")
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int      @map("sender_id")
  receiverId Int      @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, id])
  @@index([receiverId, isRead])
  @@map("chat_messages")
}