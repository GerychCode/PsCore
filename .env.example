NODE_ENV="development"

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_HOST=

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

COOKIE_SECRET=
CORS_ORIGIN="http://localhost:3000"
APPLICATION_PORT=3022


# SESSION_SECRET / COOKIE_SECRET: згенеруй випадкові рядки, напр. `openssl rand -hex 32`
SESSION_SECRET=
SESSION_NAME=
SESSION_DOMAIN=localhost
SESSION_MAX_AGE=
SESSION_HTTP_ONLY=true
# Продакшн через HTTPS: постав SESSION_SECURE=true (інакше кукі летить і по HTTP).
# Разом із цим переконайся, що CORS_ORIGIN/SESSION_DOMAIN на HTTPS-домені.
SESSION_SECURE=false
SESSION_FOLDER=session:

FILE_STORAGE_FOLDER_NAME=uploads

TELEGRAM_BOT_TOKEN=


# Базові змінні мають бути оголошені ДО тих, що з них складаються
NEXT_PUBLIC_SERVER_FILE_FOLDER=uploads
NEXT_PUBLIC_SERVER_PROTOCOL=http
NEXT_PUBLIC_SERVER_HOST=localhost
NEXT_PUBLIC_SERVER_PORT=3022

NEXT_PUBLIC_SERVER_URL="${NEXT_PUBLIC_SERVER_PROTOCOL}://${NEXT_PUBLIC_SERVER_HOST}:${NEXT_PUBLIC_SERVER_PORT}"
NEXT_PUBLIC_SERVER_FILE_STORAGE_PATH="${NEXT_PUBLIC_SERVER_URL}/${NEXT_PUBLIC_SERVER_FILE_FOLDER}"

ACCESS_PC_ENABLED=true
ACCESS_TABLET_ENABLED=true
ACCESS_MOBILE_ENABLED=false